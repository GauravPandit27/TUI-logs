/* ══════════════════════════════════════════════════════════════
   SuperLog — log_viewer.tcss
   Catppuccin Mocha palette
   ══════════════════════════════════════════════════════════════ */

Screen {
    background: #1e1e2e;
}


/* ── HealthDashboard ───────────────────────────────────────────── */

HealthDashboard {
    height: 7;
    background: #11111b;
    border-bottom: solid #313244;
    layout: horizontal;
}

/* Alert border states */
HealthDashboard.alert-error {
    border: wide #f38ba8;
}

HealthDashboard.alert-latency {
    border: wide #f9e2af;
}

MetricPanel {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    border-right: solid #313244;
}

#metric-latency {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    content-align: center middle;
    border-right: solid #313244;
}

#metric-uptime {
    width: 1fr;
    height: 100%;
    padding: 1 2;
    content-align: center middle;
}

.metric-title {
    color: #a6adc8;
    margin-bottom: 1;
}

.metric-value {
    color: #cdd6f4;
    text-style: bold;
}

Sparkline {
    margin-top: 1;
    height: 1;
}


/* ── LevelFilterBar ────────────────────────────────────────────── */

#level-filter-bar {
    height: 3;
    background: #11111b;
    border-bottom: solid #313244;
    align: left middle;
    padding: 0 2;
}

.filter-bar-label {
    color: #585b70;
    margin-right: 1;
    padding: 0 1;
    content-align: left middle;
    width: auto;
}

.level-btn {
    min-width: 9;
    height: 1;
    border: none;
    background: #313244;
    color: #6c7086;
    margin: 0 1;
}

.level-btn:hover {
    background: #45475a;
    color: #cdd6f4;
}

/* Active state per level — colour-coded */
#lvl-btn-all.level-btn-active {
    background: #cdd6f4;
    color: #11111b;
}

#lvl-btn-debug.level-btn-active {
    background: #cba6f7;
    color: #11111b;
}

#lvl-btn-info.level-btn-active {
    background: #89dceb;
    color: #11111b;
}

#lvl-btn-warn.level-btn-active {
    background: #f9e2af;
    color: #11111b;
}

#lvl-btn-error.level-btn-active {
    background: #f38ba8;
    color: #11111b;
}


/* ── Health top bar & search ───────────────────────────────────── */

#health-top-bar {
    height: 3;
    background: #1e1e2e;
    border-bottom: solid #313244;
}

#health-search-bar {
    width: 1fr;
    height: 100%;
    border: none;
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 1 2;
}

#health-search-bar:focus {
    background: #181825;
}

#health-btn-reset {
    height: 100%;
    border: none;
}

#health-filter-indicator {
    background: #89b4fa;
    color: #11111b;
    padding: 0 1;
    text-align: center;
    text-style: bold;
}

/* Pause banner */
#pause-banner {
    background: #f9e2af;
    color: #11111b;
    padding: 1;
    text-align: center;
    text-style: bold;
}


/* ── Health lower pane layout ──────────────────────────────────── */

#health-lower-pane {
    height: 1fr;
}

#health-sidebar {
    width: 32;
    background: #181825;
    border-right: solid #313244;
}

#health-sidebar-title {
    padding: 1;
    background: #313244;
    color: #cdd6f4;
    text-align: center;
    border-bottom: solid #45475a;
}

#health-trace-list {
    background: #181825;
}

#health-main-view {
    width: 1fr;
}

#live-logs-title {
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 1;
    border-bottom: solid #313244;
}

#health-log-view {
    background: #1e1e2e;
    border: none;
    margin: 0 1;
    padding: 1;
    height: 1fr;
}


/* ── Tracer screen ─────────────────────────────────────────────── */

#tracer-top-bar {
    height: 3;
    background: #1e1e2e;
    border-bottom: wide #313244;
}

#btn-back {
    margin: 0;
    min-width: 25;
    height: 100%;
    border: none;
    background: #89b4fa;
    color: #11111b;
    text-style: bold;
}

#btn-back:hover {
    background: #b4befe;
}

#search-bar {
    width: 1fr;
    height: 100%;
    border: none;
    background: #1e1e2e;
    color: #cdd6f4;
    padding: 1 2;
}

#search-bar:focus {
    background: #181825;
}

#filter-indicator {
    background: #89b4fa;
    color: #11111b;
    padding: 1;
    text-align: center;
    text-style: bold;
}

#sidebar {
    width: 32;
    background: #181825;
    border-right: solid #313244;
}

#sidebar-title {
    padding: 1;
    background: #313244;
    color: #cdd6f4;
    text-align: center;
    border-bottom: solid #45475a;
}

#trace-list {
    background: #181825;
}

#main-view {
    width: 1fr;
}

#tracer-log-view {
    background: #1e1e2e;
    border: none;
    margin: 0 1;
    padding: 1;
    height: 1fr;
}


/* ── Shared: TraceItem ─────────────────────────────────────────── */

TraceItem {
    padding: 0 1;
    color: #bac2de;
}

TraceItem:hover {
    background: #313244;
}

TraceItem.--active {
    background: #45475a;
    color: #a6e3a1;
}

.trace-label {
    background: transparent;
}
